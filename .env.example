# Copy this file to .env and adjust as needed. docker-compose.yml has working
# defaults for every one of these (matching the README's dev credentials), so
# a .env file is only required once you need values other than those defaults
# (e.g. a real JWT key and admin password outside of local/dev use).

# PostgreSQL
POSTGRES_DB=remote_shell_interrupt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port Postgres is published on (container always listens on 5432).
POSTGRES_PORT=5432

# API
ASPNETCORE_ENVIRONMENT=Development
# Host port the API is published on (container always listens on 8080).
API_PORT=5000
# Must be at least 32 characters. Generate a real one for anything beyond local/dev use.
JWT_KEY=dev-only-signing-key-change-me-0123456789-abcdefgh
ADMIN_EMAIL=admin@localhost.local
ADMIN_PASSWORD=Admin#Dev-Only-2025

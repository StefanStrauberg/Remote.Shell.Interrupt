<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Remote.Shell.Interrupt.Storehouse.Application\Remote.Shell.Interrupt.Storehouse.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
    <PackageReference Include="MySql.Data" Version="9.2.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Idempotent schema-sync script generated with:
        dotnet ef migrations script -idempotent -o Scripts/InitialDatabaseSync.sql ...
      Embedded into the assembly so the API host can apply it at startup
      without any file-system dependency.
    -->
    <EmbeddedResource Include="Scripts\InitialDatabaseSync.sql" LogicalName="InitialDatabaseSync.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required by the IdentityService implementation: cookie sign-in flows and
         IdentityConstants live behind ASP.NET Core abstractions (IHttpContextAccessor). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

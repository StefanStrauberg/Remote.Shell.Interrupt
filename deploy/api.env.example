# Copy to /opt/rsi/shared/api.env on the server (server-setup.sh does this
# for you if it's missing) and fill in real values. This file is the
# systemd EnvironmentFile for rsi-api.service - it lives outside releases/
# so deploys never touch or overwrite it.
#
# Never commit the filled-in version (deploy/api.env is gitignored).

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000

# Must match the role/database created by server-setup.sh's DB_NAME/DB_USER/DB_PASSWORD.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=remote_shell_interrupt;Username=rsi_app;Password=CHANGE_ME;Timeout=30;CommandTimeout=60;

# Optional - only needed for billing synchronization. Leave commented out to
# disable it (matches the Docker Compose default); /health/ready will then
# report the mysql-billing check unhealthy, same as documented in README.md.
#ConnectionStrings__DefaultConnection2=Server=billing-host;Port=3306;Database=billing;Uid=readonly_user;Pwd=CHANGE_ME;

# Must be at least 32 characters. Generate a real random value, e.g.:
#   openssl rand -base64 48
JwtSettings__Key=CHANGE_ME_min_32_characters_random_string

IdentitySeed__AdminEmail=admin@localhost.local
IdentitySeed__AdminPassword=CHANGE_ME_strong_password

# EF Core migrations apply automatically on every start (see README.md's
# Database section) - leave this on unless you specifically want a manual
# `dotnet ef database update` step instead.
Database__AutoMigrate=true

# nginx-rsi.conf ships listening on plain :80 - no TLS step exists in
# server-setup.sh, since an air-gapped server can't reach a public CA (e.g.
# Let's Encrypt) to issue a certificate. The auth cookie is Secure-only by
# default, and a Secure cookie is never stored/sent by the browser over plain
# HTTP - without this, every login is immediately followed by 401s on every
# page. Leave this as `false` for the stock HTTP-only deployment. If you put
# a TLS-terminating reverse proxy or load balancer in front of this server,
# remove this line (or set it to `true`) so the cookie goes back to Secure.
Cookie__RequireHttps=false

# Only needed if you serve the SPA from a different origin than this API -
# the stock deployment doesn't: nginx-rsi.conf reverse-proxies /api/ on the
# same origin as the static site, so the browser never makes a cross-origin
# request and CORS never comes into play. Leave commented out unless you've
# changed that setup.
#Cors__AllowedOrigins__0=https://your-spa-origin.example
